# Required. The bearer token services/scraper must send. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BROWSER_SECRET=

# Comma-separated. Host or any subdomain of it. Without this the service is an
# open proxy that defeats bot detection — see README.
ALLOWED_HOSTS=bayt.com

# Requests past this get a 503 rather than a queue. The caller is a Vercel
# function with its own budget; queueing helps nobody.
MAX_CONCURRENCY=4

PORT=7860
