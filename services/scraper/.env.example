# Shared secret guarding both endpoints, sent as the `x-scraper-secret` header.
#
# Without it this service is an open scraping proxy on your Vercel bandwidth,
# so it is required — src/auth.ts rejects every request when it is unset.
#
# Generate:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#
# The same value must be set in three places, or the collectors fail with a
# silent 401: here (or the Vercel project's env vars), and the `Set Config`
# node of each workflow in ../../n8n.
SCRAPER_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
#
# The stealth transport: ../browser, deployed as a container somewhere with a
# public URL. Both must be set or it does not exist, and `bayt` — the only
# source that asks for it — skips itself with a reason rather than falling back
# to plain fetch and spending its budget collecting 403s.
#
# Cloudflare rejects this runtime's TLS fingerprint before it reads a header, so
# this is the difference between Bayt being the broadest MENA source here and
# being off. See ../browser/README.md.
BROWSER_URL=
BROWSER_SECRET=

# Company enrichment resolves websites for free — Wikidata's official
# API, then a verified domain guess — because every search engine turned out to
# be closed to it anyway: DuckDuckGo disallows /lite, /html *and* all of
# api.duckduckgo.com, and Google and Bing disallow their result pages.
# See src/enrichment/resolve.ts.
